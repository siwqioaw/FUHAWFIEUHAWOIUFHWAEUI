 "lines": [
  {
   "id": "l1",
   "role": "narrator",
   "text": "[excited] Nah, why does every group project have that ONE person?",
   "emoji": "😭"
  },
  {
   "id": "l2",
   "role": "girl",
   "text": "[bubbly] Oh my gosh, you guys, I'll do the title page!",
   "emoji": "✨"
  },
  {
   "id": "l3",
   "role": "narrator",
   "text": "[sarcastic] The title page. For a forty slide project.",
   "emoji": "💀"
  },
  {
   "id": "l4",
   "role": "narrator",
   "text": "[annoyed] Then there's this guy, who hasn't answered the group chat since September.",
   "emoji": "🙄"
  },
  {
   "id": "l5",
   "role": "deep",
   "text": "[deadpan] [deep voice] Seen.",
   "emoji": "🗿"
  },
  {
   "id": "l6",
   "role": "narrator",
   "text": "[frustrated] So I do the whole thing myself. Every single slide.",
   "emoji": "😭"
  },
  {
   "id": "l7",
   "role": "narrator",
   "text": "[annoyed] And on presentation day?",
   "emoji": "👀"
  },
  {
   "id": "l8",
   "role": "girl",
   "text": "[confident] So, as WE researched..."
  },
  {
   "id": "l9",
   "role": "narrator",
   "text": "[shouting] WE?!",
   "emoji": "😡"
  },
  {
   "id": "l10",
   "role": "narrator",
   "text": "[frustrated] And we all get the same grade.",
   "emoji": "🥀"
  }
